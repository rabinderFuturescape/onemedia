# ┌─────────────── Builder Stage ──────────────────────────────────────────────
FROM node:20-slim AS builder
WORKDIR /app

# 1) Install system build-deps (for node-gyp, canvas, etc.)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 \
      python3-dev \
      python-is-python3 \
      build-essential \
      pkg-config \
      libcairo2-dev \
      libpango1.0-dev \
      libjpeg-dev \
      libgif-dev \
      librsvg2-dev \
      git \
      curl \
    && rm -rf /var/lib/apt/lists/*

# 2) Copy only package files
COPY package.json package-lock.json build.plugins.js ./
COPY apps/frontend/package.json ./apps/frontend/
COPY libraries ./libraries/

# 3) Install ALL deps (including devDependencies)
RUN npm ci

# 4) Copy the rest of your source code
COPY apps/frontend ./apps/frontend/
COPY tsconfig.base.json ./
COPY nx.json ./

# 5) Set environment variables for build
ENV NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api
ENV NEXT_PUBLIC_ONESSO_URL=http://localhost:3002
ENV NODE_ENV=production

# 6) Run plugin updates and build the Next.js app
RUN npm run update-plugins && \
    npm run prisma-generate && \
    npx nx run frontend:build:production

# └───────────────────────────────────────────────────────────────────────────────

# ┌─────────────── Runner Stage ──────────────────────────────────────────────
FROM node:20-slim AS runner
WORKDIR /app

# Install runtime dependencies
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libcairo2 \
      libpango-1.0-0 \
      libjpeg62-turbo \
      libgif7 \
      librsvg2-2 \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV NODE_ENV=production
ENV PORT=4200
ENV NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api
ENV BACKEND_URL=http://postiz-backend:3000/api
ENV BACKEND_INTERNAL_URL=http://postiz-backend:3000/api
ENV FRONTEND_URL=http://localhost:4200
ENV STORAGE_PROVIDER=local
ENV IS_GENERAL=true
ENV NOT_SECURED=true
ENV NEXT_PUBLIC_ONESSO_URL=http://localhost:3002
ENV NEXTAUTH_URL=http://localhost:4200
ENV NEXTAUTH_SECRET=onesso-nextauth-secret

# 1) Copy only the production artifacts from builder
COPY --from=builder /app/dist/apps/frontend ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# 2) Expose port
EXPOSE 4200

# 3) Launch
CMD ["npm", "run", "start:prod:frontend"]
# └───────────────────────────────────────────────────────────────────────────────
