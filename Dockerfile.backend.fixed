# Multi-stage build for backend
FROM node:20-slim AS builder

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python-is-python3 \
    build-essential \
    pkg-config \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV PYTHON=/usr/bin/python3
ENV npm_config_python=/usr/bin/python3

# Install node-gyp globally
RUN npm install -g node-gyp

# Install dependencies first (for better layer caching)
COPY package.json package-lock.json nx.json tsconfig.base.json ./
COPY apps/backend/package.json ./apps/backend/

# Install dependencies with ci for exact versions
RUN npm ci --no-fund --legacy-peer-deps

# Copy source code
COPY apps/backend ./apps/backend
COPY libraries ./libraries

# Build the application for production
RUN npm run build:backend

# Production image
FROM node:20-slim AS production

# Set working directory
WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcairo2 \
    libpango-1.0-0 \
    libjpeg62-turbo \
    libgif7 \
    librsvg2-2 \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Install only production dependencies
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/apps/backend/package.json ./apps/backend/
RUN npm ci --only=production --no-fund --legacy-peer-deps

# Copy only the built application
COPY --from=builder /app/dist/apps/backend ./

# Create uploads directory
RUN mkdir -p /app/uploads

# Expose the port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O - http://localhost:3000/api/health || exit 1

# Start the application
CMD ["npm", "start"]

# Development image
FROM node:20-slim AS development

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python-is-python3 \
    build-essential \
    pkg-config \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Set Python path
ENV PYTHON=/usr/bin/python3
ENV npm_config_python=/usr/bin/python3

# Copy package files
COPY package.json package-lock.json nx.json tsconfig.base.json ./

# Copy the backend app and libraries
COPY apps/backend ./apps/backend
COPY libraries ./libraries

# Install dependencies with more verbose output for debugging
RUN npm install --legacy-peer-deps

# Create uploads directory
RUN mkdir -p /app/uploads

# Set environment variables
ENV NODE_ENV=development
ENV PORT=3000

# Expose the port
EXPOSE 3000

# Start the backend app in development mode
CMD ["npm", "run", "dev:backend"]
