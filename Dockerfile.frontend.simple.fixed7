FROM node:20-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-dev python-is-python3 \
      build-essential pkg-config \
      libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev git curl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV NODE_ENV=development
ENV PORT=4200
ENV NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api
ENV BACKEND_URL=http://postiz-backend:3000/api
ENV BACKEND_INTERNAL_URL=http://postiz-backend:3000/api
ENV FRONTEND_URL=http://localhost:4200
ENV STORAGE_PROVIDER=local
ENV IS_GENERAL=true
ENV NOT_SECURED=true
ENV NEXT_PUBLIC_ONESSO_URL=http://localhost:3002
ENV NEXTAUTH_URL=http://localhost:4200
ENV NEXTAUTH_SECRET=onesso-nextauth-secret
ENV PYTHON=/usr/bin/python3
ENV npm_config_python=/usr/bin/python3

# Create a simple Express server for testing
RUN npm init -y && \
    npm install express cors jsonwebtoken

# Copy server.js file
COPY var/docker/frontend/server.js /app/server.js

# Create public directory
RUN mkdir -p /app/public

# Expose the port
EXPOSE 4200

# Start the server
CMD ["node", "server.js"]
