# ┌─────────────── Builder Stage ──────────────────────────────────────────────
FROM node:20-slim AS builder
WORKDIR /app

# 1) Install system build-deps (for node-gyp, canvas, etc.)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 \
      python3-dev \
      python-is-python3 \
      build-essential \
      pkg-config \
      libcairo2-dev \
      libpango1.0-dev \
      libjpeg-dev \
      libgif-dev \
      librsvg2-dev \
      git \
      curl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for build
ENV PYTHON=/usr/bin/python3
ENV npm_config_python=/usr/bin/python3
ENV NODE_ENV=production

# 2) Preflight checks - ensure required directories exist
RUN mkdir -p libraries/plugins/src/list \
    && mkdir -p libraries/nestjs-libraries/src/database/prisma

# 3) Copy only package files + scripts Prisma & plugin builder need
COPY package.json package-lock.json nx.json tsconfig.base.json build.plugins.js ./
COPY libraries/plugins/src/ ./libraries/plugins/src/
COPY libraries/nestjs-libraries/src/database/prisma ./libraries/nestjs-libraries/src/database/prisma/

# 4) Install ALL deps (including devDependencies) so update-plugins & prisma CLI exist
RUN npm ci --legacy-peer-deps --no-optional

# 5) Copy the rest of your source code
COPY apps ./apps
COPY libraries ./libraries

# 6) Run your code-generation steps
RUN npm run update-plugins \
 && npm run prisma-generate \
 && npm run build

# └───────────────────────────────────────────────────────────────────────────────


# ┌─────────────── Runner Stage ──────────────────────────────────────────────
FROM node:20-slim AS runner
WORKDIR /app

# 1) Install runtime dependencies
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libcairo2 \
      libpango-1.0-0 \
      libjpeg62-turbo \
      libgif7 \
      librsvg2-2 \
      wget \
    && rm -rf /var/lib/apt/lists/*

# 2) Set environment variables
ENV NODE_ENV=production

# 3) Copy only the production artifacts from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/libraries/nestjs-libraries/src/database/prisma ./prisma
COPY --from=builder /app/node_modules ./node_modules
COPY package.json package-lock.json ./

# 4) Remove devDependencies
RUN npm prune --production

# 5) Create any necessary runtime directories
RUN mkdir -p uploads

# 6) Expose the port
EXPOSE 3000

# 7) Launch
CMD ["node", "dist/apps/backend/main.js"]
# └───────────────────────────────────────────────────────────────────────────────
