// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String
  password      String?
  providerName  Provider
  name          String?
  lastName      String?
  isSuperAdmin  Boolean   @default(false)
  providerId    String?
  activated     Boolean   @default(true)
  pictureId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  ip            String?
  agent         String?
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  mfaBackupCodes String[]
  authLogs      AuthLog[]

  @@unique([email, providerName])
  @@index([providerId, providerName])
}

model AuthLog {
  id        String   @id @default(uuid())
  ip        String
  endpoint  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  success   Boolean
  timestamp DateTime @default(now())

  @@index([ip])
  @@index([userId])
  @@index([timestamp])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  ip        String
  eventType String
  reason    String
  timestamp DateTime @default(now())

  @@index([ip])
  @@index([eventType])
  @@index([timestamp])
}

model BlockedIP {
  id        String   @id @default(uuid())
  ip        String   @unique
  reason    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([ip])
  @@index([expiresAt])
}

enum Provider {
  LOCAL
  GOOGLE
  FACEBOOK
  TWITTER
  GITHUB
  DISCORD
  LINKEDIN
  BLUESKY
  SLACK
  TIKTOK
  WALLET
}
