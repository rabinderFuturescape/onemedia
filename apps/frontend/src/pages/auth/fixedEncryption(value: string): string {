fixedEncryption(value: string): string {
  // Use a secure algorithm
  const algorithm = 'aes-256-gcm';
  
  // Generate a random IV
  const iv = crypto.randomBytes(16);
  
  // Create a key from the secret
  const key = crypto.scryptSync(process.env.JWT_SECRET, 'salt', 32);
  
  // Create a cipher with key and IV
  const cipher = crypto.createCipheriv(algorithm, key, iv);
  
  // Encrypt the data
  let encrypted = cipher.update(value, 'utf8', 'hex');
  encrypted += cipher.final('hex');
  
  // Get the auth tag
  const authTag = cipher.getAuthTag();
  
  // Return IV, encrypted data, and auth tag
  return iv.toString('hex') + ':' + encrypted + ':' + authTag.toString('hex');
}

fixedDecryption(encryptedValue: string): string {
  // Use a secure algorithm
  const algorithm = 'aes-256-gcm';
  
  // Split the stored string to get IV, data, and auth tag
  const parts = encryptedValue.split(':');
  if (parts.length !== 3) {
    throw new Error('Invalid encrypted value format');
  }
  
  const iv = Buffer.from(parts[0], 'hex');
  const encrypted = parts[1];
  const authTag = Buffer.from(parts[2], 'hex');
  
  // Create a key from the secret
  const key = crypto.scryptSync(process.env.JWT_SECRET, 'salt', 32);
  
  // Create a decipher
  const decipher = crypto.createDecipheriv(algorithm, key, iv);
  decipher.setAuthTag(authTag);
  
  // Decrypt the data
  let decrypted = decipher.update(encrypted, 'hex', 'utf8');
  decrypted += decipher.final('utf8');
  
  return decrypted;
}