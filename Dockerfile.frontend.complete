# ┌─────────────── Builder Stage ──────────────────────────────────────────────
FROM node:20-slim AS builder
WORKDIR /app

# 1) Install system build-deps (for node-gyp, canvas, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 \
      python3-dev \
      python-is-python3 \
      build-essential \
      pkg-config \
      libcairo2-dev \
      libpango1.0-dev \
      libjpeg-dev \
      libgif-dev \
      librsvg2-dev \
      git \
      curl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV PYTHON=/usr/bin/python3
ENV npm_config_python=/usr/bin/python3

# 2) Copy only package files + scripts Prisma & plugin builder need
COPY package.json package-lock.json nx.json tsconfig.base.json build.plugins.js ./

# 3) Install ALL deps (including devDependencies) so update-plugins & prisma CLI exist
RUN npm ci --legacy-peer-deps

# 4) Copy the rest of your source code
COPY apps ./apps
COPY libraries ./libraries

# 5) Run your code-generation steps
RUN npm run update-plugins && \
    npm run prisma-generate && \
    npm run build:frontend

# └───────────────────────────────────────────────────────────────────────────────

# ┌─────────────── Runner Stage ──────────────────────────────────────────────
FROM node:20-slim AS runner
WORKDIR /app

# 1) Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
      libcairo2 \
      libpango-1.0-0 \
      libjpeg62-turbo \
      libgif7 \
      librsvg2-2 \
      wget \
    && rm -rf /var/lib/apt/lists/*

# 2) Set environment variables
ENV NODE_ENV=production
ENV PORT=4200
ENV NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api
ENV BACKEND_URL=http://postiz-backend:3000/api
ENV BACKEND_INTERNAL_URL=http://postiz-backend:3000/api
ENV FRONTEND_URL=http://localhost:4200
ENV STORAGE_PROVIDER=local
ENV IS_GENERAL=true
ENV NOT_SECURED=true
ENV NEXT_PUBLIC_ONESSO_URL=http://localhost:3002
ENV NEXTAUTH_URL=http://localhost:4200
ENV NEXTAUTH_SECRET=onesso-nextauth-secret

# 3) Copy only the production artifacts from builder
COPY --from=builder /app/dist/apps/frontend ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# 4) Expose the port
EXPOSE 4200

# 5) Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O - http://localhost:4200/api/health || exit 1

# 6) Launch
CMD ["npm", "run", "start:prod:frontend"]
# └───────────────────────────────────────────────────────────────────────────────
