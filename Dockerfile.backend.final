# ┌───────── Builder ───────────────────────────────────────────────────────────
FROM node:20-slim AS builder
WORKDIR /app

# Install build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-dev python-is-python3 \
      build-essential pkg-config \
      libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev git \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY package*.json nx.json tsconfig.base.json ./
COPY .npmrc ./

# Install all deps
RUN npm ci --legacy-peer-deps

# Copy the rest & run your generators
COPY apps/backend ./apps/backend
COPY libraries ./libraries

# Build the backend
RUN npm run build:backend

# └──────────────────────────────────────────────────────────────────────────────

# ┌───────── Runner ────────────────────────────────────────────────────────────
FROM node:20-slim AS runner
WORKDIR /app

# Install runtime dependencies for canvas
RUN apt-get update && apt-get install -y --no-install-recommends \
      libcairo2 \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libjpeg62-turbo \
      libgif7 \
      librsvg2-2 \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV DATABASE_URL=postgresql://postiz-user:postiz-password@postiz-postgres:5432/postiz-db-local
ENV REDIS_URL=redis://postiz-redis:6379
ENV FRONTEND_URL=http://localhost:4200
ENV ONESSO_URL=http://mock-onesso:3002
ENV JWT_SECRET=onesso-jwt-secret

# Copy only built artifacts + prod deps
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/backend/src/views ./dist/apps/backend/src/views
COPY package*.json ./

# Expose the port
EXPOSE 3000

# Start the backend app
CMD ["node", "dist/apps/backend/main.js"]
# └──────────────────────────────────────────────────────────────────────────────
