FROM node:20-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-dev python-is-python3 \
      build-essential pkg-config \
      libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev git \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV NODE_ENV=development
ENV PORT=3000
ENV DATABASE_URL=postgresql://postiz-user:postiz-password@postiz-postgres:5432/postiz-db-local
ENV REDIS_URL=redis://postiz-redis:6379
ENV FRONTEND_URL=http://localhost:4200
ENV ONESSO_URL=http://mock-onesso:3002
ENV JWT_SECRET=onesso-jwt-secret
ENV PYTHON=/usr/bin/python3
ENV npm_config_python=/usr/bin/python3

# Create a simple Express server for testing
RUN npm init -y && \
    npm install express cors jsonwebtoken

# Create a simple server file
COPY <<EOF /app/server.js
const express = require('express');
const cors = require('cors');
const jwt = require('jsonwebtoken');

const app = express();
const PORT = process.env.PORT || 3000;
const JWT_SECRET = process.env.JWT_SECRET || 'onesso-jwt-secret';

// Middleware
app.use(cors());
app.use(express.json());

// Health check endpoint
app.get('/api/health', (req, res) => {
  res.json({
    status: 'ok',
    timestamp: new Date().toISOString(),
    service: 'postiz-backend',
    version: '1.0.0'
  });
});

// Auth middleware
const authenticateToken = (req, res, next) => {
  const authHeader = req.headers.authorization;

  if (!authHeader || !authHeader.startsWith('Bearer ')) {
    return res.status(401).json({ message: 'Unauthorized' });
  }

  const token = authHeader.split(' ')[1];

  try {
    const decoded = jwt.verify(token, JWT_SECRET);
    req.user = decoded;
    next();
  } catch (error) {
    return res.status(401).json({ message: 'Invalid token' });
  }
};

// Protected endpoint
app.get('/api/me', authenticateToken, (req, res) => {
  res.json({
    user: req.user,
    message: 'You are authenticated!'
  });
});

// Start the server
app.listen(PORT, () => {
  console.log(\`Backend server running on port \${PORT}\`);
});
EOF

# Expose the port
EXPOSE 3000

# Start the server
CMD ["node", "server.js"]
