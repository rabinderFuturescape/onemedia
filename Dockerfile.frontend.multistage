# ┌────────── Builder Stage ──────────────────────────────────────────────────
FROM node:20-slim AS builder
WORKDIR /app

# Install build tools + canvas libs
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 \
      build-essential \
      pkg-config \
      libcairo2-dev \
      libpango1.0-dev \
      libjpeg-dev \
      libgif-dev \
      librsvg2-dev \
      git \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for build
ENV PYTHON=/usr/bin/python3
ENV npm_config_python=/usr/bin/python3
ENV NODE_ENV=development
ENV NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api
ENV NEXT_PUBLIC_ONESSO_URL=http://localhost:3002

# Install node-gyp globally
RUN npm install -g node-gyp

# Copy package files
COPY package.json package-lock.json nx.json tsconfig.base.json ./
COPY .npmrc ./.npmrc

# Install all dependencies (including devDependencies) but skip scripts
RUN npm install --legacy-peer-deps --ignore-scripts

# Copy source code
COPY apps/frontend ./apps/frontend
COPY libraries ./libraries

# Build the frontend
RUN npm run build:frontend
# └────────────────────────────────────────────────────────────────────────────

# ┌────────── Final (Runtime) Stage ───────────────────────────────────────────
FROM node:20-slim AS runner
WORKDIR /app

# Install runtime dependencies for canvas and Python for node-gyp
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 \
      build-essential \
      pkg-config \
      libcairo2-dev \
      libpango1.0-dev \
      libjpeg-dev \
      libgif-dev \
      librsvg2-dev \
      git \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3 /usr/bin/python

# Set environment variables
ENV NODE_ENV=production
ENV PORT=4200
ENV NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api
ENV BACKEND_URL=http://postiz-backend:3000/api
ENV BACKEND_INTERNAL_URL=http://postiz-backend:3000/api
ENV FRONTEND_URL=http://localhost:4200
ENV STORAGE_PROVIDER=local
ENV IS_GENERAL=true
ENV NOT_SECURED=true
ENV NEXT_PUBLIC_ONESSO_URL=http://localhost:3002
ENV NEXTAUTH_URL=http://localhost:4200
ENV NEXTAUTH_SECRET=onesso-nextauth-secret
ENV PYTHON=/usr/bin/python3
ENV npm_config_python=/usr/bin/python3

# Copy package files
COPY package.json package-lock.json ./
COPY .npmrc ./.npmrc

# Install only production dependencies but skip scripts
RUN npm install --omit=dev --no-optional --no-fund --legacy-peer-deps --ignore-scripts

# Copy built artifacts from builder stage
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/apps/frontend/public ./apps/frontend/public
COPY --from=builder /app/apps/frontend/.next ./apps/frontend/.next

# Expose the port
EXPOSE 4200

# Start the frontend app
CMD ["node", "dist/apps/frontend/main.js"]
# └────────────────────────────────────────────────────────────────────────────
