# Configure npm for native module builds
python=/usr/bin/python3
node-gyp=/usr/local/bin/node-gyp
make=/usr/bin/make
g++=/usr/bin/g++
git=/usr/bin/git

# Skip optional dependencies to avoid native module build issues
optional=false

# Disable funding messages
fund=false

# Allow legacy peer dependencies to resolve version conflicts
legacy-peer-deps=true

# Increase network timeout for large packages
network-timeout=300000
