# ┌─────────────── Builder Stage ──────────────────────────────────────────────
FROM node:20-slim AS builder
WORKDIR /app

# 1) Install system build-deps (for node-gyp, canvas, etc.)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 \
      python3-dev \
      python-is-python3 \
      build-essential \
      pkg-config \
      libcairo2-dev \
      libpango1.0-dev \
      libjpeg-dev \
      libgif-dev \
      librsvg2-dev \
      git \
      curl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for build
ENV PYTHON=/usr/bin/python3
ENV npm_config_python=/usr/bin/python3
ENV NODE_ENV=production

# 2) Copy only package files + scripts Prisma & plugin builder need
COPY package.json package-lock.json nx.json tsconfig.base.json build.plugins.js ./
COPY libraries/nestjs-libraries/src/database/prisma ./libraries/nestjs-libraries/src/database/prisma

# 3) Install ALL deps (including devDependencies) so update-plugins & prisma CLI exist
RUN npm ci --legacy-peer-deps

# 4) Copy the rest of your source code
COPY apps/backend ./apps/backend
COPY libraries ./libraries

# 5) Run your code-generation steps
RUN npm run update-plugins \
 && npm run prisma-generate \
 && npm run build:backend

# └───────────────────────────────────────────────────────────────────────────────


# ┌─────────────── Runner Stage ──────────────────────────────────────────────
FROM node:20-slim AS runner
WORKDIR /app

# Install runtime dependencies
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libcairo2 \
      libpango-1.0-0 \
      libjpeg62-turbo \
      libgif7 \
      librsvg2-2 \
      wget \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Copy only the production artifacts from builder
COPY --from=builder /app/dist/apps/backend ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/libraries/nestjs-libraries/src/database/prisma ./prisma

# Remove devDependencies
RUN npm prune --production

# Create uploads directory
RUN mkdir -p /app/uploads

# Expose the port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O - http://localhost:3000/api/health || exit 1

# Launch
CMD ["npm", "run", "start:prod"]
# └───────────────────────────────────────────────────────────────────────────────
