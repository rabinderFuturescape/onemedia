{
    auto_https off
}

:5000 {
    root * /app/var/docker/static
    file_server
    
    handle_path /api/* {
        respond "API server is not running" 503
    }
    
    handle_errors {
        respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
    }
    
    log {
        output stdout
        format console
    }
}
