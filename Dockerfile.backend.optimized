# ┌─────────────── Builder Stage ──────────────────────────────────────────────
FROM node:20-slim AS builder
WORKDIR /app

# 1) Install system build-deps (for node-gyp, canvas, etc.)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 \
      python3-dev \
      python-is-python3 \
      build-essential \
      pkg-config \
      libcairo2-dev \
      libpango1.0-dev \
      libjpeg-dev \
      libgif-dev \
      librsvg2-dev \
      git \
      curl \
    && rm -rf /var/lib/apt/lists/*

# 2) Copy only package files + scripts Prisma & plugin builder need
COPY package.json package-lock.json build.plugins.js ./
COPY libraries ./libraries/
COPY nx.json ./

# 3) Install ALL deps (including devDependencies)
RUN npm ci

# 4) Copy the rest of your source code
COPY apps/backend ./apps/backend/
COPY tsconfig.base.json ./

# 5) Run your code-generation steps and build
RUN npm run update-plugins && \
    npm run prisma-generate && \
    npx nx run backend:build:production

# └───────────────────────────────────────────────────────────────────────────────

# ┌─────────────── Runner Stage ──────────────────────────────────────────────
FROM node:20-slim AS runner
WORKDIR /app

# Install runtime dependencies
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libcairo2 \
      libpango-1.0-0 \
      libjpeg62-turbo \
      libgif7 \
      librsvg2-2 \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# 1) Copy only the production artifacts from builder
COPY --from=builder /app/dist/apps/backend ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# 2) Create uploads directory
RUN mkdir -p /app/uploads

# 3) Launch
EXPOSE 3000
CMD ["node", "dist/main.js"]
# └───────────────────────────────────────────────────────────────────────────────
