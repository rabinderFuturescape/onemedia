# ┌─────────────── Builder Stage ──────────────────────────────────────────────
FROM node:20-slim AS builder
WORKDIR /app

# 1) Install system build-deps (for node-gyp, canvas, etc.)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 \
      python3-dev \
      python-is-python3 \
      build-essential \
      pkg-config \
      libcairo2-dev \
      libpango1.0-dev \
      libjpeg-dev \
      libgif-dev \
      librsvg2-dev \
      git \
      curl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for build
ENV PYTHON=/usr/bin/python3
ENV npm_config_python=/usr/bin/python3
ENV NODE_ENV=production
ENV NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api
ENV NEXT_PUBLIC_ONESSO_URL=http://localhost:3002

# 2) Create necessary directories to prevent ENOENT errors
RUN mkdir -p libraries/plugins/src/list \
    && mkdir -p libraries/nestjs-libraries/src/database/prisma

# 3) Copy only package files + scripts needed for dependency install & code-gen
COPY package.json package-lock.json nx.json tsconfig.base.json build.plugins.js ./

# 4) Copy prisma schema and plugin directories
COPY libraries/nestjs-libraries/src/database/prisma ./libraries/nestjs-libraries/src/database/prisma
COPY libraries/plugins/src ./libraries/plugins/src

# 5) Install ALL deps (including devDependencies) with peer-deps fallback
RUN npm ci --legacy-peer-deps --no-optional

# 6) Copy the rest of your source code
COPY apps/frontend ./apps/frontend
COPY libraries ./libraries

# 7) Run your code-generation steps in sequence
RUN npm run update-plugins \
 && npm run prisma-generate \
 && npm run build:frontend

# └───────────────────────────────────────────────────────────────────────────────


# ┌─────────────── Runner Stage ──────────────────────────────────────────────
FROM node:20-slim AS runner
WORKDIR /app

# 1) Install runtime dependencies only
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libcairo2 \
      libpango-1.0-0 \
      libjpeg62-turbo \
      libgif7 \
      librsvg2-2 \
      wget \
    && rm -rf /var/lib/apt/lists/*

# 2) Set environment variables
ENV NODE_ENV=production
ENV PORT=4200
ENV NEXT_PUBLIC_BACKEND_URL=http://localhost:3000/api
ENV BACKEND_URL=http://postiz-backend:3000/api
ENV BACKEND_INTERNAL_URL=http://postiz-backend:3000/api
ENV FRONTEND_URL=http://localhost:4200
ENV STORAGE_PROVIDER=local
ENV IS_GENERAL=true
ENV NOT_SECURED=true
ENV NEXT_PUBLIC_ONESSO_URL=http://localhost:3002
ENV NEXTAUTH_URL=http://localhost:4200
ENV NEXTAUTH_SECRET=onesso-nextauth-secret

# 3) Copy only the production artifacts from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# 4) Remove devDependencies to keep image minimal
RUN npm prune --production

# 5) Expose the application port
EXPOSE 4200

# 6) Set the entrypoint
CMD ["npm", "run", "start:prod:frontend"]
# └───────────────────────────────────────────────────────────────────────────────
